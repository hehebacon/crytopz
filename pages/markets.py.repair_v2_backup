
from __future__ import annotations

import customtkinter as ctk

from market_data import (
    InstrumentRegistry,
    MarketDataProvider,
)


class MarketsPage(ctk.CTkFrame):
    """
    Crytopz Markets Page.

    DESIGN:
        Market LIST:
            -> chỉ tải/reload khi bấm nút Refresh.

        Market PRICE:
            -> tự cập nhật realtime.

        Search:
            -> chỉ lọc danh sách hiện tại.

        Filter:
            -> chỉ lọc danh sách hiện tại.

    IMPORTANT:
        Realtime price updates NEVER rebuild the table.
    """

    # ============================================================
    # SETTINGS
    # ============================================================

    # Giá update mỗi 1 giây.
    # Không dùng refresh_rows() trong timer.
    PRICE_UPDATE_MS = 1000
    PRICE_REQUEST_TIMEOUT_MS = 15000

    def __init__(
        self,
        parent,
        app,
    ):
        super().__init__(
            parent,
            corner_radius=0,
            fg_color="transparent",
        )

        self.app = app

        # ========================================================
        # MARKET DATA
        # ========================================================

        self.registry = InstrumentRegistry()

        self.provider = MarketDataProvider(
            getattr(
                self.app,
                "engine",
                None,
            )
        )

        # ========================================================
        # STATE
        # ========================================================

        self.selected_type = "ALL"

        # Toàn bộ instruments hiện đang load.
        self.all_instruments = []

        # Các row đang hiển thị.
        #
        # symbol -> {
        #     frame,
        #     instrument,
        #     price_label,
        # }
        self.rows = {}

        # Chỉ có MỘT UI timer.
        self._price_job = None

        # Background market-data state.
        self._price_thread = None
        self._price_request_running = False
        self._price_generation = 0

        # Cached snapshots:
        # symbol -> {
        #     price,
        #     change_24h,
        #     source,
        # }
        self._snapshots = {}

        self._destroyed = False

        # ========================================================
        # BUILD UI
        # ========================================================

        self.build_ui()

        # ========================================================
        # INITIAL LOAD
        # ========================================================

        # Load danh sách một lần khi page được tạo.
        self.load_market_list()

        # ========================================================
        # START REALTIME PRICE LOOP
        # ========================================================

        self.start_price_updates()

        # ========================================================
        # DESTROY HANDLER
        # ========================================================

        self.bind(
            "<Destroy>",
            self._on_destroy,
            add="+",
        )

