    # ============================================================
    # REALTIME PRICE SYSTEM
    # ============================================================

    def start_price_updates(self):
        """
        Start one UI timer.

        Network/provider work is NEVER performed directly by
        the Tkinter timer.
        """

        if self._destroyed:
            return

        if self._price_job is not None:
            try:
                self.after_cancel(self._price_job)
            except Exception:
                pass

            self._price_job = None

        self.update_prices(
            schedule_next=True
        )

    # ============================================================

    def update_prices(
        self,
        schedule_next=True,
    ):
        """
        Request market snapshots in a background thread.

        Tkinter is only touched from the UI callback.
        """

        if self._destroyed:
            return

        symbols = list(self.rows.keys())

        if not symbols:
            self._schedule_price_timer(
                schedule_next
            )
            return

        # Do not create another worker while one is running.
        if self._price_request_running:
            self._schedule_price_timer(
                schedule_next
            )
            return

        self._price_request_running = True
        self._price_generation += 1

        generation = self._price_generation

        def worker():
            snapshots = {}

            try:
                for symbol in symbols:

                    if self._destroyed:
                        return

                    try:
                        snapshot = (
                            self.provider.get_snapshot(
                                symbol
                            )
                        )

                        if not isinstance(
                            snapshot,
                            dict,
                        ):
                            snapshot = {
                                "symbol": symbol,
                                "price": None,
                                "change_24h": None,
                                "source": "unknown",
                            }

                    except Exception:
                        snapshot = {
                            "symbol": symbol,
                            "price": None,
                            "change_24h": None,
                            "source": "unknown",
                        }

                    snapshots[symbol] = snapshot

            finally:
                try:
                    self.after(
                        0,
                        lambda:
                            self._apply_price_snapshots(
                                generation,
                                snapshots,
                            ),
                    )
                except Exception:
                    self._price_request_running = False

        import threading

        self._price_thread = threading.Thread(
            target=worker,
            name="CrytopzMarketData",
            daemon=True,
        )

        self._price_thread.start()

        # Timer is scheduled independently.
        self._schedule_price_timer(
            schedule_next
        )

    # ============================================================

    def _schedule_price_timer(
        self,
        schedule_next,
    ):
        if (
            not schedule_next
            or self._destroyed
        ):
            return

        if self._price_job is not None:
            try:
                self.after_cancel(
                    self._price_job
                )
            except Exception:
                pass

        try:
            self._price_job = self.after(
                self.PRICE_UPDATE_MS,
                self._scheduled_price_update,
            )
        except Exception:
            self._price_job = None

    # ============================================================

    def _apply_price_snapshots(
        self,
        generation,
        snapshots,
    ):
        """
        Runs on Tkinter's UI thread.
        """

        if self._destroyed:
            return

        if generation != self._price_generation:
            return

        self._price_request_running = False

        live_count = 0
        paper_count = 0

        for symbol, data in snapshots.items():

            if self._destroyed:
                return

            row = self.rows.get(symbol)

            if row is None:
                continue

            self._snapshots[symbol] = data

            instrument = row.get(
                "instrument"
            )

            price_label = row.get(
                "price_label"
            )

            change_label = row.get(
                "change_label"
            )

            price = data.get(
                "price"
            )

            change = data.get(
                "change_24h"
            )

            source = str(
                data.get(
                    "source",
                    "unknown",
                )
            ).lower()

            try:
                currency = getattr(
                    instrument,
                    "currency",
                    "USD",
                )

                price_label.configure(
                    text=self.format_price(
                        price,
                        currency,
                    )
                )
            except Exception:
                pass

            try:
                if change is None:
                    change_label.configure(
                        text="—",
                        text_color="gray",
                    )

                else:
                    change = float(change)

                    if change > 0:
                        change_label.configure(
                            text=f"+{change:.2f}%",
                            text_color="#4ade80",
                        )

                    elif change < 0:
                        change_label.configure(
                            text=f"{change:.2f}%",
                            text_color="#f87171",
                        )

                    else:
                        change_label.configure(
                            text="0.00%",
                            text_color="gray",
                        )

            except Exception:
                pass

            if price is not None:

                if source == "external":
                    live_count += 1

                else:
                    paper_count += 1

        total = len(
            self.rows
        )

        if live_count > 0:

            text = (
                f"LIVE • "
                f"{live_count}/{total} prices"
            )

            if paper_count:
                text += (
                    f" • PAPER fallback "
                    f"{paper_count}"
                )

            self.status_label.configure(
                text=text,
                text_color="#4ade80",
            )

        elif paper_count > 0:

            self.status_label.configure(
                text=(
                    f"PAPER • "
                    f"{paper_count}/{total} prices"
                ),
                text_color="#facc15",
            )

        else:

            self.status_label.configure(
                text="Waiting for market data...",
                text_color="gray",
            )

    # ============================================================

    def _scheduled_price_update(self):
        """
        Tkinter timer callback.

        No network access here.
        """

        self._price_job = None

        if self._destroyed:
            return

        self.update_prices(
            schedule_next=True
        )


    # ============================================================
    # SNAPSHOT ACCESS
    # ============================================================

    def get_cached_snapshot(
        self,
        symbol: str,
    ):
        """
        Return the last known snapshot without performing I/O.
        """

        return self._snapshots.get(
            str(symbol).upper()
        )

    # ============================================================
    # TRADE
    # ============================================================

    def open_trade(
        self,
        symbol: str,
    ):

        self.app.show_page(
            "Trade"
        )

        trade = self.app.pages.get(
            "Trade"
        )

        if (
            trade
            and hasattr(
                trade,
                "change_symbol",
            )
        ):

            trade.change_symbol(
                symbol
            )

    # ============================================================
    # SYMBOL FORMAT
    # ============================================================

    @staticmethod
    def _display_symbol(
        symbol: str,
    ) -> str:

        symbol = str(
            symbol
        ).upper()

        # BTCUSDT
        # ->
        # BTC / USDT

        if (
            symbol.endswith("USDT")
            and len(symbol) > 4
        ):

            return (
                f"{symbol[:-4]} / USDT"
            )

        # EURUSD
        # ->
        # EUR / USD

        if (
            symbol.endswith("USD")
            and len(symbol) > 3
        ):

            return (
                f"{symbol[:-3]} / USD"
            )

        return symbol

    # ============================================================
    # PRICE FORMAT
    # ============================================================

    @staticmethod
    def format_price(
        price,
        currency: str,
    ) -> str:

        if price is None:
            return "—"

        try:

            value = float(
                price
            )

        except (
            ValueError,
            TypeError,
        ):

            return "—"

        currency = str(
            currency
        ).upper()

        symbols = {
            "USD": "$",
            "USDT": "$",
            "EUR": "€",
            "GBP": "£",
            "JPY": "¥",
            "HKD": "HK$",
            "CNY": "¥",
            "KRW": "₩",
            "SGD": "S$",
            "AUD": "A$",
            "CAD": "C$",
        }

        prefix = symbols.get(
            currency,
            f"{currency} ",
        )

        # --------------------------------------------------------
        # Format
        # --------------------------------------------------------

        if abs(value) >= 1:

            formatted = (
                f"{value:,.2f}"
            )

        else:

            formatted = (
                f"{value:,.6f}"
            )

        return (
            f"{prefix}{formatted}"
        )

    # ============================================================
    # DESTROY
    # ============================================================

    def _on_destroy(
        self,
        event,
    ):

        if event.widget is not self:
            return

        self._destroyed = True

        # Invalidate any worker result that is still returning.
        self._price_generation += 1
        self._price_request_running = False

        # Cancel the ONLY timer.

        if self._price_job is not None:

            try:

                self.after_cancel(
                    self._price_job
                )

            except Exception:
                pass

            self._price_job = None

